{% extends "site/base.html.j2" %}
{% import "site/_macros.html.j2" as m %}

{% block title %}{{ issue.date_label }} — {{ newsletter.name }}{% endblock %}
{% block description %}{{ issue.headline }}{% endblock %}
{% block canonical %}{{ issue.path }}{% endblock %}

{% block content %}

<div class="issue-head">
  <span class="issue-head__kicker">Edição</span>
  <h1 class="issue-head__title">{{ issue.date_label }}</h1>
  <p class="issue-head__stats">
    {{ issue.total }} {{ 'itens' if issue.total != 1 else 'item' }} em
    {{ issue.categories | length }} {{ 'categorias' if issue.categories | length != 1 else 'categoria' }}
  </p>
</div>

<hr class="divider">

{{ m.groups(issue) }}

<nav class="issue-nav">
  {% if older %}
  <a href="{{ older.slug }}.html">
    <span class="issue-nav__dir">← Anterior</span>
    <span class="issue-nav__label">{{ older.date_label }}</span>
  </a>
  {% endif %}
  {% if newer %}
  <a class="issue-nav__next" href="{{ newer.slug }}.html">
    <span class="issue-nav__dir">Seguinte →</span>
    <span class="issue-nav__label">{{ newer.date_label }}</span>
  </a>
  {% endif %}
</nav>

{% endblock %}
