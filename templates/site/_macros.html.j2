{% macro item(a) %}
<article class="item">
  <h3 class="item__title"><a href="{{ a.url }}" rel="noopener">{{ a.title }}</a></h3>
  {% if a.summary %}<p class="item__summary">{{ a.summary }}</p>{% endif %}
  <div class="item__meta">
    <span class="item__source">{{ a.source_name }}</span>
    {% if a.published_label %}<span class="item__dot"></span><span>{{ a.published_label }}</span>{% endif %}
    {% if a.author %}<span class="item__dot"></span><span>{{ a.author }}</span>{% endif %}
  </div>
</article>
{% endmacro %}


{% macro groups(issue) %}
{% for category, items in issue.groups.items() %}
<section class="section">
  <div class="section__head">
    <h2 class="section__title">{{ category }}</h2>
    <span class="section__rule"></span>
    <span class="section__count">{{ items | length }}</span>
  </div>
  {% for a in items %}{{ item(a) }}{% endfor %}
</section>
{% endfor %}
{% endmacro %}


{# Só existe quando há um provedor de assinatura configurado. Sem
   site.subscribe_url o bloco não é renderizado: nada de anunciar um
   cadastro que ainda não funciona. #}
{% macro subscribe(site, depth='', hero=false) %}
{% if site.subscribe_url %}
<div class="subscribe{% if hero %} subscribe--hero{% endif %}">
  <p class="subscribe__title">Uma edição por semana, na segunda</p>
  <p class="subscribe__text">O que saiu de design em 16 publicações, filtrado e agrupado.</p>
  <form class="subscribe__form" action="{{ site.subscribe_url }}" method="post" target="_blank">
    <input class="subscribe__input" type="email" name="{{ site.subscribe_field }}" placeholder="seu@email.com" required aria-label="Seu e-mail">
    <button class="btn btn--primary" type="submit">Assinar</button>
  </form>
  <p class="subscribe__note">Sem custo. Cancele quando quiser.</p>
</div>
{% endif %}
{% endmacro %}


{% macro entry(issue, prefix='') %}
<a class="entry" href="{{ prefix }}{{ issue.path }}">
  <span class="entry__date">{{ issue.date_label }}</span>
  <h3 class="entry__title">{{ issue.headline }}</h3>
  {% if issue.excerpt %}<p class="entry__excerpt">{{ issue.excerpt }}</p>{% endif %}
  <p class="entry__meta">{{ issue.total }} {{ 'itens' if issue.total != 1 else 'item' }} · {{ issue.categories | join(' · ') }}</p>
</a>
{% endmacro %}
