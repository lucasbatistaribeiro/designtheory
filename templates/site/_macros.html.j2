{% macro item(a) %}
<article class="item">
  <h3 class="item__title"><a href="{{ a.url }}" rel="noopener">{{ a.title }}</a></h3>
  {% if a.summary %}<p class="item__summary">{{ a.summary }}</p>{% endif %}
  <div class="item__meta">
    <span class="item__source">{{ a.source_name }}</span>
    {% if a.published_label %}<span class="item__dot"></span><span>{{ a.published_label }}</span>{% endif %}
    {% if a.author %}<span class="item__dot"></span><span>{{ a.author }}</span>{% endif %}
  </div>
</article>
{% endmacro %}


{% macro groups(issue) %}
{% for category, items in issue.groups.items() %}
<section class="section">
  <div class="section__head">
    <h2 class="section__title">{{ category }}</h2>
    <span class="section__rule"></span>
    <span class="section__count">{{ items | length }}</span>
  </div>
  {% for a in items %}{{ item(a) }}{% endfor %}
</section>
{% endfor %}
{% endmacro %}


{# Tile tipográfico: sem imagem, o título é que carrega o peso visual.
   data-category alimenta o filtro da fase 4 — inerte por enquanto. #}
{% macro tile(a) %}
<a class="tile" href="{{ a.url }}" rel="noopener" data-category="{{ a.category_slug }}">
  <span class="tile__cat">{{ a.category }}</span>
  <h3 class="tile__title">{{ a.title }}</h3>
  <span class="tile__meta">
    <span class="tile__source">{{ a.source_name }}</span>
    {% if a.published_label %}<span>{{ a.published_label }}</span>{% endif %}
  </span>
</a>
{% endmacro %}


{# Os chips só existem com JavaScript: sem ele o CSS os esconde e a grade
   aparece inteira, em vez de oferecer um controle que não funciona. #}
{% macro filters(issue) %}
{% if issue.filters %}
<div class="filters" data-filters>
  <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
    Todos <span class="filter__count">{{ issue.total }}</span>
  </button>
  {% for f in issue.filters %}
  <button class="filter" type="button" data-filter="{{ f.slug }}" aria-pressed="false">
    {{ f.label }} <span class="filter__count">{{ f.count }}</span>
  </button>
  {% endfor %}
</div>
<p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
{% endif %}
{% endmacro %}


{% macro gallery(issue) %}
<div class="gallery" data-gallery>
  {% for a in issue.items %}{{ tile(a) }}{% endfor %}
</div>
{% endmacro %}


{% macro entry(issue, prefix='') %}
<a class="entry" href="{{ prefix }}{{ issue.path }}">
  <span class="entry__date">{{ issue.date_label }}</span>
  <h3 class="entry__title">{{ issue.headline }}</h3>
  {% if issue.excerpt %}<p class="entry__excerpt">{{ issue.excerpt }}</p>{% endif %}
  <p class="entry__meta">{{ issue.total }} {{ 'itens' if issue.total != 1 else 'item' }} · {{ issue.categories | join(' · ') }}</p>
</a>
{% endmacro %}
