{% extends "site/base.html.j2" %}
{% import "site/_macros.html.j2" as m %}

{% block title %}{{ newsletter.name }} — {{ newsletter.tagline }}{% endblock %}

{% block content %}

{% if latest %}
<div class="issue-head">
  <span class="issue-head__kicker">Última edição</span>
  <h1 class="issue-head__title">{{ latest.date_label }}</h1>
  <p class="issue-head__stats">
    {{ latest.total }} {{ 'itens' if latest.total != 1 else 'item' }} em
    {{ latest.categories | length }} {{ 'categorias' if latest.categories | length != 1 else 'categoria' }}
  </p>
</div>

<hr class="divider">

{{ m.groups(latest) }}

{% if recent %}
<hr class="divider">

<section class="section">
  <div class="section__head">
    <h2 class="section__title">Edições anteriores</h2>
    <span class="section__rule"></span>
  </div>
  {% for issue in recent %}{{ m.entry(issue) }}{% endfor %}
  {% if has_more %}
  <p style="margin:1.5rem 0 0;text-align:center">
    <a class="btn btn--ghost" href="arquivo.html">Ver todas as edições</a>
  </p>
  {% endif %}
</section>
{% endif %}

{% else %}
<div class="empty">
  <p class="empty__title">Nenhuma edição ainda</p>
  <p class="empty__text">A primeira sai na próxima segunda-feira.</p>
  <a class="btn btn--ghost" href="fontes.html">Ver as fontes acompanhadas</a>
</div>
{% endif %}

{% endblock %}
